<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Dynamic RFC1918 interfaces cannot be expressed here. Every WLED HTTP request is instead literal-IPv4 validated in WledDiscovery: no hostnames, redirects, non-private addresses, or paths outside /json/info,/json/state. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
